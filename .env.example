# Production runtime environment. Local development generates .env.local with npm run setup.
PUBLIC_ORIGIN=https://your-project.vercel.app
# Local API override only. Leave unset on Vercel; the Nest API is a Vercel function.
API_INTERNAL_URL=http://127.0.0.1:4107
API_PORT=4107
API_HOST=127.0.0.1
DATABASE_URL=postgresql://tidepool_app.PROJECT_REF:REPLACE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://jpkwqgodyuxxnveevgpy.supabase.co
SUPABASE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
OTP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DB_POOL_MAX=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_GMAIL_ADDRESS
SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
MAIL_FROM="Tidepool <your-gmail-address@gmail.com>"
RETENTION_DAYS=365
# Set only behind a private, fixed-length proxy chain that replaces incoming forwarding headers.
TRUST_PROXY_HOPS=0
