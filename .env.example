# Production runtime environment. Local development generates .env.local with npm run setup.
PUBLIC_ORIGIN=https://events.example.edu
API_INTERNAL_URL=http://127.0.0.1:4107
API_PORT=4107
API_HOST=127.0.0.1
DATABASE_URL=postgresql://society_app:REPLACE_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
OTP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_GMAIL_ADDRESS
SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
MAIL_FROM="Tidepool <your-gmail-address@gmail.com>"
RETENTION_DAYS=365
# Set only behind a private, fixed-length proxy chain that replaces incoming forwarding headers.
TRUST_PROXY_HOPS=0
