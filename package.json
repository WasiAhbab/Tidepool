{
  "name": "tidepool-events",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3107",
    "dev:api": "tsc -p backend && node --env-file=.env.local backend/dist/main.js",
    "build": "tsc -p backend && next build",
    "start:web": "next start -p 3107",
    "start:api": "node backend/dist/main.js",
    "test": "node --env-file=.env.local --test --test-concurrency=1 tests/api.test.mjs tests/domains.test.mjs",
    "test:browser": "node --env-file=.env.local tests/browser.mjs",
    "compose": "node scripts/compose.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p backend",
    "lint": "eslint src backend/src --max-warnings 0",
    "format:check": "prettier --check src backend/src tests scripts",
    "test:unit": "tsc -p backend && node --env-file=.env.local --test tests/unit.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@zxing/browser": "^0.2.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "supabase": "^2.122.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
